---
import { journey } from '../data/site';
// Sporcu yolu: masaüstünde bölüm ekrana sabitlenir, kaydırdıkça optimist rota boyunca dört durağa kayar.
// Mobilde sabitleme yok: dört adım alt alta bir zaman çizelgesi olarak akar (uzun "boş" kaydırma olmasın).
const D = 'M40 210 C 160 210 170 80 300 90 S 460 230 560 200 S 720 60 820 90 S 930 170 970 150';
const stops = [0.1, 0.4, 0.68, 0.96];
---
<section id="yolculuk" class="journey" data-buoy="Sporcu yolu" data-journey>
  <div class="sticky">
    <div class="wrap">
      <header class="head">
        <p class="eyebrow">Neden Çandarlı Yelken?</p>
        <h2 class="h2">İlk dersten milli takıma uzanan bir rota</h2>
        <p class="lead">Yaz okulu bir başlangıç. Hedefimiz, mümkün olduğunca çok çocuğun denizle bağ kurması ve dileyenin sporcu olarak yoluna devam etmesi.</p>
      </header>

      <div class="route">
        <svg viewBox="0 0 1000 280" aria-hidden="true">
          <defs>
            <linearGradient id="seaGrad" x1="0" x2="1">
              <stop offset="0" stop-color="var(--sea-light)" /><stop offset="1" stop-color="var(--sea)" />
            </linearGradient>
          </defs>
          <path class="r-base" d={D} />
          <path class="r-done" d={D} pathLength="1" data-done />
          {stops.map((s, i) => <g class="stop" data-stop={s}><circle r="13" /><text dy="5">{i + 1}</text></g>)}
          <g data-jboat><g class="jb-inner"><svg x="-42" y="-74" width="84" height="84" viewBox="0 0 100 100">
            <g class="opti-sail-g">
              <line x1="40" y1="12" x2="40" y2="76" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
              <path d="M41.5 70 L41.5 18 L79 7 Q84 36 83 66 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round" />
              <line x1="41.5" y1="60" x2="78" y2="8.5" stroke="var(--ink)" stroke-width="1.6" opacity="0.7" />
              <line x1="40" y1="70.5" x2="83" y2="66.5" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" />
            </g>
            <circle cx="66" cy="66" r="4.6" fill="#f2c9a5" stroke="var(--ink)" stroke-width="1.4" />
            <path d="M61.5 64.5 q4.5 -6 9 0" fill="var(--sun)" stroke="var(--ink)" stroke-width="1.2" />
            <rect x="61" y="70" width="10" height="9" rx="3" fill="#e8463a" stroke="var(--ink)" stroke-width="1.4" />
            <path d="M12 76 L90 76 Q89 86 80 88 L22 88 Q14 87 12 76 Z" fill="#fff" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round" />
            <path d="M15 80 L88 80" stroke="var(--sea)" stroke-width="2" />
          </svg></g></g>
        </svg>
      </div>

      <ol class="stages">
        {journey.map((j, i) => (
          <li data-stage={i} class={i === 0 ? 'on' : ''}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{j.step}</h3>
            <p>{j.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-journey]');
  if (sec) {
    const svg = sec.querySelector('svg')!;
    const base = svg.querySelector<SVGPathElement>('.r-base')!;
    const done = svg.querySelector<SVGPathElement>('[data-done]')!;
    const boat = svg.querySelector<SVGGElement>('[data-jboat]')!;
    const inner = svg.querySelector<SVGGElement>('.jb-inner')!;
    const stages = [...sec.querySelectorAll<HTMLElement>('[data-stage]')];
    const stopEls = [...svg.querySelectorAll<SVGGElement>('[data-stop]')];
    const len = base.getTotalLength();
    const stops = stopEls.map((g) => Number(g.dataset.stop));
    stopEls.forEach((g, i) => { const p = base.getPointAtLength(stops[i] * len); g.setAttribute('transform', `translate(${p.x} ${p.y})`); });

    const mobile = matchMedia('(max-width: 860px)');
    let current = -1;
    const render = () => {
      if (mobile.matches) return;
      const r = sec.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = Math.min(1, Math.max(0, -r.top / (span || 1)));
      const at = Math.max(0.0001, p) * len;
      const pt = base.getPointAtLength(at);
      const ahead = base.getPointAtLength(Math.min(len, at + 4));
      const back = base.getPointAtLength(Math.max(0, at - 4));
      const ang = Math.atan2(ahead.y - back.y, ahead.x - back.x) * (180 / Math.PI);
      // Tekne sola bakıyor; sağa ilerlediği için aynala, rota eğimine göre eğil
      boat.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
      inner.setAttribute('transform', `rotate(${Math.max(-30, Math.min(30, ang * 0.6))}) scale(-1 1)`);
      done.style.strokeDashoffset = String(1 - p);
      let idx = 0;
      stops.forEach((s, i) => { if (p >= s - 0.08) idx = i; });
      stopEls.forEach((g, i) => g.classList.toggle('hit', i <= idx));
      if (idx !== current) { current = idx; stages.forEach((s, i) => s.classList.toggle('on', i === idx)); }
    };
    let tick = false;
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(() => { render(); tick = false; }); } }, { passive: true });
    addEventListener('resize', render);
    // Mobil: ekranın ortasına gelen adım vurgulanır
    const io = new IntersectionObserver((es) => {
      if (mobile.matches) es.forEach((e) => e.target.classList.toggle('on', e.isIntersecting));
    }, { rootMargin: '-48% 0px -48% 0px' });
    stages.forEach((s) => io.observe(s));
    mobile.addEventListener('change', () => { current = -1; stages.forEach((s) => s.classList.remove('on')); render(); });
    render();
  }
</script>

<style>
  .journey { position: relative; height: 320vh; background: linear-gradient(180deg, var(--paper), var(--foam) 30%, var(--foam) 70%, var(--paper)); }
  .sticky { position: sticky; top: 0; min-height: 100svh; display: flex; align-items: center; padding-block: 5.5rem 1.5rem; }
  .head { max-width: 46rem; }
  .head .h2 { font-size: var(--step-2); }
  .head .lead { font-size: var(--step-0); }
  .route { margin: 0 0 0.5rem; }
  .route svg { width: 100%; height: auto; max-height: 30vh; overflow: visible; }
  .r-base { fill: none; stroke: var(--sea-light); stroke-width: 3; stroke-dasharray: 2 10; stroke-linecap: round; }
  .r-done { fill: none; stroke: url(#seaGrad); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .stop circle { fill: var(--paper); stroke: var(--sea-light); stroke-width: 3; transition: fill 0.4s, stroke 0.4s; }
  .stop text { font: 700 14px var(--font-body); text-anchor: middle; fill: var(--ink-soft); }
  .stop.hit circle { fill: var(--sun); stroke: var(--ink); }
  .stop.hit text { fill: var(--ink); }

  .stages { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .stages li { padding: 1.1rem 1.2rem 1.25rem; border-radius: var(--radius); background: oklch(1 0 0 / 0.55); border: 1px solid transparent; opacity: 0.5; transition: opacity 0.5s, background 0.5s, border-color 0.5s, translate 0.6s var(--ease-out); }
  .stages li.on { opacity: 1; background: #fff; border-color: var(--sea-light); translate: 0 -6px; box-shadow: var(--shadow); }
  .num { font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--sun); font-weight: 700; }
  .stages h3 { font-size: var(--step-1); margin: 0.2rem 0 0.4rem; }
  .stages p { font-size: 0.95rem; color: var(--ink-soft); line-height: 1.5; }

  @media (max-width: 860px) {
    .journey { height: auto; }
    .sticky { position: static; min-height: 0; padding-block: 4.5rem 3rem; }
    .route { display: none; }
    .head { margin-bottom: 1.75rem; }
    .stages { grid-template-columns: 1fr; gap: 0.9rem; position: relative; padding-left: 2.4rem; counter-reset: st; }
    .stages::before { content: ''; position: absolute; left: 0.9rem; top: 1.4rem; bottom: 1.4rem; border-left: 3px dotted var(--sea-light); }
    .stages li { position: relative; opacity: 1; translate: none; counter-increment: st; }
    .stages li::before {
      content: counter(st); position: absolute; left: -2.4rem; top: 1.1rem; width: 1.85rem; height: 1.85rem; border-radius: 50%;
      display: grid; place-items: center; font: 700 0.8rem var(--font-body); color: var(--ink-soft);
      background: var(--paper); border: 3px solid var(--sea-light); transition: background 0.4s, border-color 0.4s, color 0.4s;
    }
    .stages li.on::before { background: var(--sun); border-color: var(--ink); color: var(--ink); }
    .stages li.on { translate: none; }
  }
  @media (max-height: 760px) and (min-width: 861px) { .head .lead { display: none; } }
</style>
